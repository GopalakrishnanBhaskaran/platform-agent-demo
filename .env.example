# Azure Credentials
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id-here
AZURE_TENANT_ID=your-azure-tenant-id-here
AZURE_CLIENT_ID=your-azure-client-id-here
AZURE_CLIENT_SECRET=your-azure-client-secret-here

# OpenAI API (for Intent Parsing)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Databricks (for Unity Catalog support)
# Only required if you want to create Unity Catalog resources
DATABRICKS_TOKEN=your-databricks-pat-token-here
DATABRICKS_WORKSPACE_URL=adb-xxxxxxxxxxxxx.xx.azuredatabricks.net

# Optional: Custom Configuration
# AZURE_RESOURCE_GROUP=rg-platform-demo
# AZURE_LOCATION=eastus
